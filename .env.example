# Persistence: without MONGODB_URI the app writes reports to ./data (dev only).
MONGODB_URI=
MONGODB_DB=stackpick

# Console access. Visit /app?key=<token> once, then the cookie carries it.
STACKPICK_CONSOLE_TOKEN=

# Report sharing. Without it, emails are logged to the server console instead of sent.
RESEND_API_KEY=
STACKPICK_FROM="StackPick <reports@stackpick.ai>"
STACKPICK_BASE_URL=http://localhost:3000

# Optional cookieless human web analytics. Enable Cookieless processing in the PostHog project too.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
